# Local makepkg runs. The recipe in RELEASING.md builds in a scratch directory --
# makepkg's own working dirs are deliberately not listed here, because src/ and pkg/
# are ordinary Go source directory names and ignoring them repo-wide would silently
# drop real files from `git add -A`.
*.pkg.tar.zst
*.pkg.tar.zst.sig

# Test artifacts
/testdata/generated/

# Temporary files
*.tmp
*.log

.claude/settings.local.json
