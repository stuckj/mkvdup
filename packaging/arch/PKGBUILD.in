# Maintainer: stuckj <stuckj@users.noreply.github.com>
#
# Generated by the mkvdup release workflow from packaging/arch/PKGBUILD.in.
# Changes belong in that template: https://github.com/stuckj/mkvdup

pkgname=@PKGNAME@
pkgver=@PKGVER@
pkgrel=1
pkgdesc="@PKGDESC@"
arch=('x86_64' 'aarch64')
url='https://github.com/stuckj/mkvdup'
license=('MIT')
depends=('fuse3' 'glibc')
makedepends=('go')
# Arch's stock OPTIONS include debug, which splits a -debug package out of every
# build. Nothing here publishes one, so it would only ever be an unused asset.
#
# !lto for the reason several official Arch Go packages exporting CGO_CFLAGS do:
# mkvdup is pure Go today so -flto reaches only the final link and does nothing,
# but that stops being true the moment a cgo dependency arrives.
options=('!debug' '!lto')
source=("${pkgname}-${pkgver}.tar.gz::@SRC_URL@")
sha256sums=('@SHA256_SRC@')

# The archive unpacks to the repository name and the tag without its leading v,
# which is not $pkgname/$pkgver once a canary mangles the hyphen to an underscore.
_srcdir="mkvdup-@VERSION@"

build() {
  cd "$_srcdir"

  # The flag set Arch's Go packages use: CGO picks up the distribution's
  # hardening flags, and PIE with external linking is what makes the result
  # match what the official repositories ship.
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  # -buildvcs=false because the stamp is wrong here and the attempt is fatal.
  # Go stamps VCS metadata when it finds a .git above the source; the archive can
  # be unpacked anywhere, including inside an unrelated repository, and then go
  # shells out to git and dies on exit 128 rather than skipping it. The commit it
  # would record would not be mkvdup's in any case.
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw -buildvcs=false"

  # -linkmode=external and -extldflags belong in this one string, not in GOFLAGS:
  # a command-line -ldflags replaces the GOFLAGS one outright rather than adding
  # to it, so splitting them drops the linker mode silently and with it the
  # CGO_LDFLAGS hardening above -- the binary still builds, just without BIND_NOW
  # or full RELRO.
  #
  # @VERSION@ rather than $pkgver: the binary reports the version upstream
  # released, not the one mangled to satisfy pacman's pkgver rules.
  go build -o "$pkgname" \
    -ldflags "-linkmode=external -extldflags '${LDFLAGS}' -X 'main.version=@VERSION@'" \
    ./cmd/mkvdup
}

check() {
  cd "$_srcdir"
  # The suites needing FUSE, root or generated media are excluded by build tag,
  # so a plain run is the subset that can pass in a packaging chroot.
  go test ./...
}

package() {
  cd "$_srcdir"

  install -Dm755 "$pkgname" "${pkgdir}/usr/bin/${pkgname}"

  # The helper execs the binary its own filename ends in, so installing it as
  # mount.fuse.mkvdup-canary is what makes a canary mount run the canary binary.
  # It lands in /usr/bin rather than /usr/sbin, which Arch forbids packages from
  # writing to.
  install -Dm755 scripts/mount.fuse.mkvdup "${pkgdir}/usr/bin/mount.fuse.${pkgname}"

  # The man page ships with placeholders that the release tooling expands; a
  # source build has to do it here.
  sed -e "s/@PACKAGE_NAME_UPPER@/$(printf '%s' "$pkgname" | tr '[:lower:]' '[:upper:]')/g" \
      -e "s/@PACKAGE_NAME@/${pkgname}/g" \
      docs/mkvdup.1 > "${srcdir}/${pkgname}.1"
  install -Dm644 "${srcdir}/${pkgname}.1" "${pkgdir}/usr/share/man/man1/${pkgname}.1"

  install -Dm644 scripts/mkvdup-completion.bash \
    "${pkgdir}/usr/share/bash-completion/completions/${pkgname}"
  install -Dm644 scripts/mkvdup-completion.zsh \
    "${pkgdir}/usr/share/zsh/site-functions/_${pkgname}"
  install -Dm644 scripts/mkvdup.fish \
    "${pkgdir}/usr/share/fish/vendor_completions.d/${pkgname}.fish"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}" README.md DESIGN.md
  install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}/docs" docs/*.md
}
